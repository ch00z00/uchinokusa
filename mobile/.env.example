# ローカル開発用の環境変数の例。コピーして使う：cp .env.example .env
# （.env はリポジトリに含めない）
# EXPO_PUBLIC_ の変数はアプリに埋め込まれ、誰でも読める。秘密の値を入れない。

# API のベースの URL（サーバーは server/README.md の手順で起動する）
# Android のエミュレーターからは localhost ではなく 10.0.2.2 を使う
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/v1

# Firebase：ローカルでは Auth Emulator のデモプロジェクトを使う（サーバーの FIREBASE_PROJECT_ID と同じ値にする）
EXPO_PUBLIC_FIREBASE_API_KEY=fake-api-key
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-uchinokusa
# この変数があると、Firebase Auth は本物ではなく Emulator に接続する
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
