# ローカル開発用の環境変数の例。コピーして使う：cp .env.example .env
# （.env はリポジトリに含めない）

PORT=8080
DATABASE_URL=postgres://uchinokusa:uchinokusa@localhost:54320/uchinokusa?sslmode=disable
LOG_LEVEL=debug

# Firebase：ローカルでは Emulator のデモプロジェクトを使う
FIREBASE_PROJECT_ID=demo-uchinokusa
# この変数があると、Firebase Admin SDK は本物の Firebase ではなく Emulator に接続する
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# 本番の Firebase に接続するときだけ、サービスアカウントの鍵ファイルを指定する（Cloud Run では不要）
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# 許可するオリジン（カンマ区切り）
ALLOWED_ORIGINS=
